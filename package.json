{
  "name": "fluxion",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web",
    "apps/companion"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w packages/shared -w apps/server -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "start": "npm run start -w apps/server",
    "db:up": "docker compose -f docker/compose.dev.yml -p fluxion up -d",
    "db:down": "docker compose -f docker/compose.dev.yml -p fluxion down",
    "test": "npm run build -w packages/shared && vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
