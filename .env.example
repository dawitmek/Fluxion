DATABASE_URL=postgres://fluxion:fluxion@127.0.0.1:5432/fluxion
# Change if another program already uses 3000; the dashboard dev server (npm run dev) follows it.
PORT=3000
HOST=127.0.0.1
# Optional: Euler Stream key for TikTok signing (https://www.eulerstream.com)
EULER_API_KEY=

# Optional: a TikTok account for TikTok voices, used by every host who hasn't signed in with their own in the
# companion. The value of that account's sessionid cookie. Use a spare account: the TikTok voice API is unofficial.
TIKTOK_SESSION_ID=

# Self-hosting with docker/compose.yml (the DATABASE_URL/HOST/PORT above are for local development):
# POSTGRES_PASSWORD=change-me
# COOKIE_SECURE=false   # only when serving plain HTTP on a private network; keep true behind HTTPS
# FLUXION_BIND=127.0.0.1  FLUXION_PORT=3000   # where the container's port is published

# Optional server-side text-to-speech outside Docker (the Docker image sets these itself):
# PIPER_BIN=/path/to/piper
# PIPER_VOICES_DIR=/path/to/voices
